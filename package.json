{
  "name": "academic-paper-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Academic paper discovery and retrieval backend over official scholarly APIs (DOAJ, PubMed Central, CORE, arXiv, Semantic Scholar, Crossref, OpenAlex).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "search": "tsx tests/manual/searchCli.ts",
    "probe": "tsx tests/manual/sourceProbe.ts"
  },
  "keywords": [
    "academic",
    "papers",
    "doi",
    "open-access",
    "crossref",
    "openalex",
    "arxiv"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
