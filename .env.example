# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API keys
#
# Every key below is OPTIONAL except where noted. Sources whose key is optional
# fall back to the free public API. Sources whose key is REQUIRED are skipped
# gracefully (status "skipped") when the key is absent - never faked, guessed
# or brute-forced.
#
#   DOAJ                -> no key needed for public article search (optional)
#   NCBI / PubMed       -> optional; raises rate limit from 3 rps to 10 rps
#   CORE                -> REQUIRED (https://core.ac.uk/services/api)
#   arXiv               -> no key, public Atom API
#   Semantic Scholar    -> optional; raises shared-pool limits
#   Crossref            -> no key; CROSSREF_MAILTO enables the polite pool
#   OpenAlex            -> no key; OPENALEX_MAILTO enables the polite pool
#   Europe PMC          -> no key needed
#   DataCite            -> no key needed
#
# NOTE on OpenAlex: the free tier also has a DAILY credit quota. When it is
# spent, OpenAlex replies 429 with Retry-After set to the next reset (~12h).
# The service reports that source as rate-limited and carries on with the
# others - it never blocks waiting for it.
# ---------------------------------------------------------------------------
DOAJ_API_KEY=
NCBI_API_KEY=
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_API_KEY=
OPENALEX_API_KEY=

# Contact address used in the User-Agent and the polite pools.
#
# SET THIS TO A REAL ADDRESS YOU MONITOR. It is not decoration:
#   - Unpaywall (the main open-access PDF index) REJECTS placeholder addresses,
#     so leaving this as-is disables it and you will get fewer PDF links.
#   - Crossref and OpenAlex give better service to identified clients.
# The placeholder below is deliberately never sent to those services.
CONTACT_EMAIL=contact@example.com
CROSSREF_MAILTO=
OPENALEX_MAILTO=

# ---------------------------------------------------------------------------
# Rate limiting / retries (conservative defaults; per-source overrides live in
# src/config/rateLimits.ts)
# ---------------------------------------------------------------------------
DEFAULT_REQUESTS_PER_SECOND=1
DEFAULT_MAX_CONCURRENCY=1
DEFAULT_MAX_RETRIES=2

RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RETRY_JITTER=true

REQUEST_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Circuit breaker
# ---------------------------------------------------------------------------
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000
CIRCUIT_HALF_OPEN_SUCCESSES=2

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=5000

# ---------------------------------------------------------------------------
# Search budget
# ---------------------------------------------------------------------------
MAX_PRIMARY_SOURCES=5
MAX_FALLBACK_SOURCES=2
MAX_EXTENDED_SOURCES=2
MAX_RESULTS_PER_SOURCE=20
MAX_SIMILAR_PAPERS=10
MIN_SIMILAR_PAPERS=8
MAX_SIMILAR_CANDIDATES=50
SEARCH_DEADLINE_MS=45000
# Budget for the best-effort PDF lookup across the returned result list.
FULLTEXT_ENRICH_MS=12000

# ---------------------------------------------------------------------------
# Matching
# ---------------------------------------------------------------------------
EXACT_MATCH_THRESHOLD=0.95
NEAR_EXACT_MATCH_THRESHOLD=0.85
TITLE_EXACT_THRESHOLD=0.97

# Small nudge so that, between two comparably relevant papers, the more recent
# one ranks first. Set to 0 to rank purely by relevance.
RECENCY_BOOST=0.05

# Similarity weights (must sum to 1.0)
SIM_WEIGHT_TITLE=0.4
SIM_WEIGHT_ABSTRACT=0.3
SIM_WEIGHT_KEYWORDS=0.2
SIM_WEIGHT_TOPICS=0.1

# ---------------------------------------------------------------------------
# Source ordering
# ---------------------------------------------------------------------------
# Tier 1: searched first.
SOURCE_PRIORITY=doaj,pubmed,core,arxiv,semanticScholar
# Tier 2: only when tier 1 found nothing.
FALLBACK_SOURCE_PRIORITY=crossref,openalex
# Tier 3 (last resort): only when tiers 1 AND 2 found nothing. Europe PMC and
# DataCite index preprints, theses and repository deposits the others miss.
EXTENDED_SOURCE_PRIORITY=europepmc,datacite
# Consulted when resolving a legal full text, in order. These are asked no
# matter which source found the paper: whether a free copy exists is
# independent of where the metadata came from.
FULLTEXT_SOURCE_PRIORITY=europepmc,unpaywall,openalex,pubmed,core,semanticScholar
SIMILAR_SOURCE_PRIORITY=semanticScholar,openalex,europepmc,arxiv,core

# ---------------------------------------------------------------------------
# HTTP server security
# ---------------------------------------------------------------------------
MAX_BODY_SIZE=100kb
SERVER_REQUEST_TIMEOUT_MS=60000
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
